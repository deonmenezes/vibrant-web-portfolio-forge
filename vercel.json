{
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.virelity.com"
        }
      ],
      "destination": "https://virelity.com/:path",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "deonmenezes.com"
        }
      ],
      "destination": "/deon",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.deonmenezes.com"
        }
      ],
      "destination": "/deon",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/viral",
      "destination": "https://viral-89458c.vercel.app/viral"
    },
    {
      "source": "/viral.css",
      "destination": "https://viral-89458c.vercel.app/viral.css"
    },
    {
      "source": "/viral.js",
      "destination": "https://viral-89458c.vercel.app/viral.js"
    },
    {
